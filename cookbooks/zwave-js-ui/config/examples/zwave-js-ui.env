# Development credentials and session secret for Z-Wave JS UI.
#
# NOT FOR PRODUCTION: an operator provides this file with its own values, out of
# a vault. See the README.
#
# SESSION_SECRET signs the session cookies and the API tokens. Provided here so
# that sessions survive a store that is wiped between two iterations; absent, one
# is generated and persisted in the store.
SESSION_SECRET=development-session-secret-not-for-production
# Credentials of the administrator account, created on the FIRST start only (once
# store/users.json exists, changing these values does nothing).
DEFAULT_USERNAME=admin
DEFAULT_PASSWORD=zwave
