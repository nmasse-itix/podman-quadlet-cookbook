[Unit]
Description=Lego Let's Encrypt client
Documentation=https://go-acme.github.io/lego/
Requires=lego.timer lego-hooks.path
# A failure to obtain or renew a certificate (network issue, ACME server down, etc.)
# must not stop the target. lego.timer will try again later.
Wants=lego.service
After=lego.service lego.timer lego-hooks.path

# Allow isolation - can stop/start this target independently
AllowIsolate=yes

[Install]
# Start by default on boot
WantedBy=multi-user.target default.target
