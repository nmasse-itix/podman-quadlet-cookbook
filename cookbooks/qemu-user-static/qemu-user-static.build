[Unit]
Description=multiarch /usr/bin/qemu-*-static
Documentation=https://github.com/multiarch/qemu-user-static
Wants=network-online.target fedora-image.service
After=network-online.target fedora-image.service

[Build]
File=/etc/quadlets/qemu-user-static/container/Containerfile
ImageTag=localhost/qemu-user-static:latest
SetWorkingDirectory=/etc/quadlets/qemu-user-static/container
