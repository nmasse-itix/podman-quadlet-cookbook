variant: fcos
version: 1.4.0
passwd:
  users:
  - name: core
    should_exist: false
  - name: itix-svc
    uid: 10000
    gecos: ITIX Misc. Services
    home_dir: /tmp
    primary_group: itix-svc
  groups:
  - name: core
    should_exist: false
  - name: itix
    gid: 1000
  - name: itix-svc
    gid: 10000
